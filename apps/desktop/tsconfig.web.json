{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@turingflow/agent-kit/ui": ["../../packages/agent-kit/src/ui/index.ts"],
      "@turingflow/agent-kit/styles.css": ["../../packages/agent-kit/src/ui/style/styles.css"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    // SDK UI 源码直接进 program 后，需要它自带的 prism ambient 声明。
    "../../packages/agent-kit/src/ui/**/*.d.ts"
  ]
}
