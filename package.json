{
  "name": "linger",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Linger：开源桌面个人智能体——Electron 桌面端 + Next.js 后台服务 + 本地 Agent SDK（agent-kit）",
  "homepage": "https://github.com/aituringflow/linger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aituringflow/linger.git"
  },
  "bugs": {
    "url": "https://github.com/aituringflow/linger/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "build:web": "npm run build -w web",
    "dev:web": "npm run dev -w web",
    "dev:web:https": "npm run dev:https -w web",
    "login": "node --import tsx packages/agent-kit/src/server/auth-cli.ts login",
    "logout": "node --import tsx packages/agent-kit/src/server/auth-cli.ts logout",
    "dev:desktop": "npm run dev -w desktop"
  },
  "author": "TuringFlow",
  "engines": {
    "node": ">=24.9"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "agent",
    "desktop",
    "electron",
    "ai",
    "knowledge-base"
  ]
}
