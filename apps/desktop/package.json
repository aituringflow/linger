{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Linger 桌面端：macOS 式 Dock + 桌面 + 可恢复会话的 Electron 应用",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aituringflow/linger.git",
    "directory": "apps/desktop"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-statusctl.mjs && node scripts/build-wechat-windowctl.mjs && node scripts/launch-electron.js dev",
    "start": "node scripts/launch-electron.js start",
    "build": "node scripts/build-statusctl.mjs && node scripts/build-wechat-windowctl.mjs && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "node ../../scripts/build-launcher.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@huggingface/transformers": "4.3.2",
    "@napi-rs/canvas": "^0.1.100",
    "@summersmile/voice-dictation": "^0.1.0",
    "@tencent-ai/agent-sdk": "^0.3.299",
    "@turingflow/agent-kit": "*",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "jieba-wasm": "^2.4.0",
    "mammoth": "^1.13.0",
    "onnxruntime-node": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.3.1",
    "sax": "^1.6.1",
    "tesseract.js": "^7.0.0",
    "unzipper": "^0.12.5",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "author": "TuringFlow",
  "engines": {
    "node": ">=24.9"
  }
}
