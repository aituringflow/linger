# Web 应用（同时也是 launcher 的后端）的环境变量清单。
# 复制为 apps/web/.env 后按需填写；所有值都是占位，切勿把真实密钥提交进仓库。
# 这是本项目唯一的环境变量说明：agent-kit 作为库不再单独维护 .env.example。

# ============================================================
# 1. 应用与数据目录
# ============================================================
# 应用名决定本机数据根目录：~/.<AGENT_APP_NAME>（会话、产物、知识库、模型配置都在这里）。
AGENT_APP_NAME=linger
# 想把数据放到别处才需要设；默认就是 ~/.linger
# AGENT_DATA_DIR=/data/linger
# 服务对外地址：登录回调、分享链接，以及桌面端未设 WEB_SERVER_URL 时的兜底。
# 填 origin 即可（不要带 /linger，basePath 由 Next 负责）；本地默认 http://localhost:3100。
# APP_PUBLIC_URL=http://localhost:3100

# ============================================================
# 2. 登录认证
# ============================================================
# builtin（PostgreSQL 内置账号）| feishu | dingtalk | adaptive | none（多项用 | 或 , 分隔）
AUTH_PROVIDER=builtin
# 会话 cookie 签名密钥：Web 与桌面端必须一致，否则登录态互相不认。
# 生成方式：openssl rand -hex 32
AUTH_SESSION_SECRET=replace_with_a_long_random_secret
# 必须与 Next basePath 一致
AUTH_COOKIE_PATH=/linger
# 本地 http 用 false，HTTPS 部署改 true
AUTH_SECURE_COOKIE=false

# ============================================================
# 3. 数据库（PostgreSQL，可选）
# ============================================================
# HOST 与 DB 同时配置才启用持久化；任一缺失则自动跳过落库，登录仍可用。
# 所有表建在该库的 schema `linger` 下，库名本身不限。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=linger
POSTGRES_PASSWORD=replace_with_password

# ============================================================
# 4. 语音识别
# ============================================================
# 腾讯云实时语音识别：桌面端按住说话、网页端语音输入都用它。
# 凭据只留在服务端，由 /api/audio/session 签发临时凭证，不下发客户端。
TENCENT_CLOUD_APP_ID=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh

# 通用 ASR（可选；不填则语音按钮禁用）
# AGENT_KIT_ASR_PROVIDER=xiaomi
# AGENT_KIT_ASR_HOST=https://your-asr-host.example.com
# AGENT_KIT_ASR_API_KEY=replace_with_api_key
# 语音令牌签名密钥（默认回退到 AUTH_SESSION_SECRET）
# AGENT_KIT_VOICE_TOKEN_SECRET=

# ============================================================
# 5. 日志
# ============================================================
# debug（会把 CLI 消息流全量时间线写入）| info | warn | error
AGENT_KIT_LOG_LEVEL=info
# 默认 <应用 cwd>/logs/sessions，即 apps/web/logs/sessions；要换目录再取消注释
# AGENT_KIT_LOG_DIR=/var/log/linger/sessions
